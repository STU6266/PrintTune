{
  "name": "printtune-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "PrintTune monorepo (tooling only)",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --verbose",
    "test": "vitest run",
    "build": "tsc -b && pnpm --filter @printtune/desktop build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
